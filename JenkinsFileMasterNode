pipeline {
    agent none
    stages {
        stage('Master Execution') {
            agent { label 'master' }
            steps {
                sh 'docker compose down || true'
                sh 'docker compose up --scale chrome=2 -d'
                sh 'docker compose run --rm java-tests mvn test -Dtags=@high -DrunMode=docker'
            }
            post {
                always {
                    sh 'docker compose down || true'
                }
            }
        }
    }
}